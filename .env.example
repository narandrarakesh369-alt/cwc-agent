# ==============================================================================
# CWC AI WORKFORCE - ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase (Online Database & Storage - Zero Local Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Telegram Bot (Founder's Remote Command Center)
# 1. Create a bot using @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
# 2. Your personal Telegram User ID (so only YOU can approve actions and command the CEO)
TELEGRAM_FOUNDER_CHAT_ID="your_telegram_user_id"

# AI Model Provider (Gemini API for CEO and 10 Departments)
GEMINI_API_KEY="AIzaSy..."

# Public App URL (Your Vercel deployment URL or localhost for testing)
NEXT_PUBLIC_APP_URL="https://cwc-workforce.vercel.app"

# Qikink (Quickink) Print-On-Demand (POD) API
# Environment: 'sandbox' (for testing without real print charges) or 'production' (for live fulfillment)
QUICKINK_ENV="sandbox"
QUICKINK_CLIENT_ID="your_qikink_client_id"
QUICKINK_CLIENT_SECRET="your_qikink_client_secret"
# Alternatively, static API key if your Qikink account uses bearer tokens:
QUICKINK_API_KEY=""

